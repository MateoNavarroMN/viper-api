# Puerto en el que escucha la API (por defecto 3000)
PORT=3000

# Orígenes permitidos por CORS, separados por coma.
# Si se deja vacío o se borra, se permite cualquier origen.
CORS_ORIGIN=http://localhost:5173

# Conexión a Postgres de Supabase
DATABASE_URL=postgresql://postgres.<REF>:<PASSWORD>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Clave con la que se firman los tokens de sesión (JWT). Tiene que ser larga y secreta.
# Generar una: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-una-clave-larga-y-secreta

# Horas de duración de la sesión (opcional, 8 por defecto)
# JWT_HORAS=8

# Supabase Storage (imágenes de productos). La service role es secreta: solo backend.
SUPABASE_URL=http
SUPABASE_SERVICE_ROLE_KEY=eyJ
SUPABASE_BUCKET_PRODUCTOS=productos

# Mercado Pago (cobro en línea). Credenciales de prueba mientras se desarrolla.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=pegá-acá-la-public-key
# Clave secreta del webhook de Mercado Pago (panel de la aplicación → Webhooks)
MP_WEBHOOK_SECRET=
# Dirección pública del front a la que vuelve el jugador después de pagar (sin barra final)
MP_BACK_URL_BASE=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000