# Puerto en el que escucha la API (por defecto 3000)
PORT=3000

# Orígenes permitidos por CORS, separados por coma.
# Si se deja vacío o se borra, se permite cualquier origen.
CORS_ORIGIN=http://localhost:5173

# Conexión a Postgres de Supabase
DATABASE_URL=postgresql://postgres.<REF>:<PASSWORD>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Clave con la que se firman los tokens de sesión (JWT). Tiene que ser larga y secreta.
# Generar una: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-una-clave-larga-y-secreta

# Horas de duración de la sesión (opcional, 8 por defecto)
# JWT_HORAS=8